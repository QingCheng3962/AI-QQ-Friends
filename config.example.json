{
  "framework": "snowluma",
  "snowluma": {
    "launcherPath": "",
    "mode": "forward",
    "url": "ws://127.0.0.1:3001",
    "accessToken": "",
    "listenHost": "0.0.0.0",
    "listenPort": 3002,
    "autoConfigNewAccounts": true
  },
  "napcat": {
    "launcherPath": "",
    "mode": "forward",
    "url": "ws://127.0.0.1:3001",
    "accessToken": "",
    "listenHost": "0.0.0.0",
    "listenPort": 3002,
    "autoConfigNewAccounts": true
  },
  "groups": [],
