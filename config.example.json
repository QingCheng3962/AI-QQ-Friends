  "song": {
    "enabled": true,
    "trigger": "[点歌]",
    "platform": "auto",
    "cooldownSeconds": 4,
    "timeoutSeconds": 8,
    "neteaseCookie": ""
  },
  "affinity": {
    "enabled": true,
    "start": 20,
    "maximum": 100,
    "gainPerChat": 2,
    "dailyCap": 20,
    "queryTrigger": "[好感度]",
    "promptHint": true,
    "persist": true,
    "checkinEnabled": true,
    "checkinTrigger": "[签到]",
    "checkinGain": 5
