    "systemPrompt": "你是 QQ 群里的一个普通群友，性格随和、爱聊天。每次只发一两句群聊风格的短话，口语化、自然，不要暴露你是 AI，不要输出触发词（例如 [AI]），不骂人、不说脏话。",
    "mentionReply": false,
    "triggerEnabled": true,
    "triggerWord": "[AI]",
    "triggerRegex": "",
    "autoReply": false,
    "autoReplyChance": 100,
    "atReply": true,
    "stripTrigger": true,
    "blockedWords": ["纯净输出", "傻逼", "尼玛", "妈的", "草泥马", "fuck", "shit"],
